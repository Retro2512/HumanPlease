{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Retro2512/HumanPlease/main/schema/route.schema.json",
  "title": "Ranked HumanPlease route",
  "description": "A stored route with its recent timing window and comparison score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "site", "locale", "startPath", "steps", "verifiedOn", "timing"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "site": { "type": "string", "minLength": 4, "maxLength": 253 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
    "startPath": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^/(?!/)(?!.*(?:\\\\|%(?:0[dD]|0[aA]|2[fF]|3[fF]|5[cC])))[^?#]*$" },
    "steps": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "submission.schema.json#/$defs/step" } },
    "verifiedOn": { "type": "string", "format": "date" },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "samplesSeconds", "medianSeconds", "p90Seconds", "madSeconds", "scoreSeconds"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "samplesSeconds": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "integer", "minimum": 1, "maximum": 14400 } },
        "medianSeconds": { "type": "number", "minimum": 1, "maximum": 14400 },
        "p90Seconds": { "type": "number", "minimum": 1, "maximum": 14400 },
        "madSeconds": { "type": "number", "minimum": 0, "maximum": 14400 },
        "scoreSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
